{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "bells",
  "type": "object",
  "required": ["version", "dayTypes", "weekdayMap"],
  "properties": {
    "version": { "const": 1 },
    "dayTypes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["start", "end", "kind"],
          "properties": {
            "n": { "type": "integer", "minimum": 1, "maximum": 12 },
            "start": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
            "end": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
            "kind": { "enum": ["lesson", "break", "lunch"] }
          },
          "additionalProperties": false
        }
      }
    },
    "weekdayMap": {
      "type": "object",
      "required": ["1", "2", "3", "4", "5"],
      "additionalProperties": { "type": "string" }
    }
  },
  "additionalProperties": false
}
