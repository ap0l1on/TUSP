{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "announcements",
  "type": "object",
  "required": ["version", "announcements"],
  "properties": {
    "version": { "const": 1 },
    "announcements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "body", "priority", "audience", "publish", "expires", "pinned"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "body": { "type": "string" },
          "priority": { "enum": ["urgent", "normal", "info"] },
          "audience": { "type": "array", "items": { "type": "string" } },
          "publish": { "type": "string", "format": "date-time" },
          "expires": { "type": "string", "format": "date-time" },
          "pinned": { "type": "boolean" },
          "eventId": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
